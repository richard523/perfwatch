def pct_label(pct, warn=30, crit=15):
    if pct < crit:
        return f"{pct:.0f}%", "metric-crit"
    elif pct < warn:
        return f"{pct:.0f}%", "metric-warn"
    return f"{pct:.0f}%", "metric-ok"


def temp_label(temp, warn=80, crit=90):
    if temp >= crit:
        return f"{temp}C", "metric-crit"
    elif temp >= warn:
        return f"{temp}C", "metric-warn"
    return f"{temp}C", "metric-ok"


def psi_label(val, warn=5.0, crit=10.0):
    if val >= crit:
        return f"{val:.1f}%", "metric-crit"
    elif val >= warn:
        return f"{val:.1f}%", "metric-warn"
    return f"{val:.1f}%", "metric-ok"


class Bar(Gtk.Box):
    def __init__(self, fill_class, width=200, height=14):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL)
        self.set_css_classes(["bar-trough"])
        self.set_size_request(width, height)
        self._fill = Gtk.Box()
        self._fill.set_css_classes(["bar-fill", fill_class])
        self._fill.set_size_request(0, height)
        self.append(self._fill)
        self._w = width
        self._h = height

    def set_pct(self, pct):
        pct = max(0, min(100, pct))
        self._fill.set_size_request(int(self._w * pct / 100), self._h)


class Dashboard(Adw.Application):
    def __init__(self, interval=2, debug=False):
        super().__init__(application_id="dev.chard.perfwatch")
        self.interval = interval
        self.debug = debug
        self.history = deque(maxlen=60)
        self._widgets = {}
        self._pinned = False
        self._timeout_id = None
        self._win = None

    def do_activate(self):
        self._build_window()

    def _build_window(self):
        # Cancel old timeout before rebuilding
        if self._timeout_id is not None:
            GLib.source_remove(self._timeout_id)
            self._timeout_id = None

        # Destroy old window if it exists
        if self._win is not None:
            self._win.destroy()
            self._widgets = {}

        win = Adw.ApplicationWindow(application=self)
        win.set_title("perfwatch")
        win.set_default_size(520, 720)
        win.set_icon_name("perfwatch")
        self._win = win

        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        main_box.set_margin_start(16)
        main_box.set_margin_end(16)
        main_box.set_margin_top(12)
        main_box.set_margin_bottom(12)
        main_box.set_css_classes(["perfwatch-bg"])

        self._build_header(main_box)
        self._build_mem_section(main_box)
        self._build_cpu_section(main_box)
        self._build_audio_section(main_box)
        self._build_oom_section(main_box)
        self._build_procs_section(main_box)

        scrolled.set_child(main_box)
        win.set_content(scrolled)
        win.present()

        # Start refresh timer
        self._refresh()
        self._timeout_id = GLib.timeout_add_seconds(self.interval, self._refresh)

    def _section_title(self, box, title):
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.set_css_classes(["section-title"])
        box.append(lbl)

    def _metric_row(self, box, label_text, key):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_margin_bottom(2)
        lbl = Gtk.Label(label=label_text, xalign=0)
        lbl.set_css_classes(["metric-label"])
        lbl.set_hexpand(True)
        val = Gtk.Label(label="--", xalign=1)
        val.set_css_classes(["metric-value"])
        row.append(lbl)
        row.append(val)
        box.append(row)
        self._widgets[key] = val

    def _build_header(self, box):
        # WindowHandle makes the header draggable to move the window
        handle = Gtk.WindowHandle()

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_css_classes(["header-bar"])

        title = Gtk.Label(xalign=0)
        title.set_markup("<b>perfwatch</b>  <small>performance dashboard</small>")
        title.set_css_classes(["header-title"])
        title.set_hexpand(True)

        # Pin (always on top) toggle button
        pin_btn = Gtk.ToggleButton()
        pin_btn.set_icon_name("view-pin-symbolic")
        pin_btn.set_tooltip_text("Always on top")
        pin_btn.set_css_classes(["header-btn"])
        pin_btn.set_active(self._pinned)
        pin_btn.connect("toggled", self._toggle_pin)

        # Close button
        close_btn = Gtk.Button()
        close_btn.set_icon_name("window-close-symbolic")
        close_btn.set_tooltip_text("Close")
        close_btn.set_css_classes(["header-btn"])
        close_btn.connect("clicked", self._on_close)

        header.append(title)
        header.append(pin_btn)
        header.append(close_btn)
        handle.set_child(header)
        box.append(handle)

    def _toggle_pin(self, btn):
        self._pinned = btn.get_active()
        if self._pinned:
            btn.add_css_class("pin-active")
        else:
            btn.remove_css_class("pin-active")
        # Call the perfwatch-above GNOME Shell extension via DBus.
        # The extension exports at /dev/chard/Perfwatch on GNOME Shell's
        # unique bus name. We look up the owner of org.gnome.Shell first.
        try:
            # Get GNOME Shell's unique bus name
            owner = subprocess.run(
                ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
                 "--object-path", "/org/freedesktop/DBus",
                 "--method", "org.freedesktop.DBus.GetNameOwner", "org.gnome.Shell"],
                capture_output=True, text=True, timeout=2
            )
            if owner.returncode != 0:
                btn.set_tooltip_text("Always-on-top needs GNOME Shell extension")
                return
            # Parse the unique name from "(':1.X',)"
            unique_name = owner.stdout.strip().strip("()").strip("'").rstrip(",").strip()
            r = subprocess.run(
                ["gdbus", "call", "--session", "--dest", unique_name,
                 "--object-path", "/dev/chard/Perfwatch",
                 "--method", "dev.chard.Perfwatch.ToggleAbove", "perfwatch"],
                capture_output=True, text=True, timeout=3
            )
            if r.returncode != 0:
                btn.set_tooltip_text("Extension not loaded. Log out/back in.")
                if self.debug:
                    print(f"pin dbus failed: {r.stderr.strip()}", file=sys.stderr)
            else:
                btn.set_tooltip_text("Always on top")
                if self.debug:
                    print(f"pin dbus: {r.stdout.strip()}", file=sys.stderr)
        except Exception as e:
            if self.debug:
                print(f"pin failed: {e}", file=sys.stderr)

    def _on_close(self, btn):
        if self._timeout_id is not None:
            GLib.source_remove(self._timeout_id)
        self.quit()

    def _kill_proc(self, btn, pid, name):
        try:
            os.kill(pid, 15)  # SIGTERM
            if self.debug:
                print(f"killed pid {pid} ({name})", file=sys.stderr)
        except ProcessLookupError:
            pass  # already gone
        except PermissionError:
            # Try via pkexec for root-owned processes
            subprocess.Popen(["pkexec", "kill", "-15", str(pid)])

    def _build_mem_section(self, box):
        self._section_title(box, "Memory / Pressure")
        self._metric_row(box, "RAM available", "mem_pct")
        self._widgets["mem_bar"] = Bar("bar-mem")
        box.append(self._widgets["mem_bar"])
        self._metric_row(box, "Swap free", "swap_pct")
        self._widgets["swap_bar"] = Bar("bar-swap")
        box.append(self._widgets["swap_bar"])
        self._metric_row(box, "PSI some (avg10)", "psi_some")
        self._metric_row(box, "PSI full (avg10)", "psi_full")

    def _build_cpu_section(self, box):
        self._section_title(box, "CPU / Thermal")
        self._metric_row(box, "Load (1m / 5m)", "load")
        self._metric_row(box, "CPU freq", "cpu_freq")
        self._metric_row(box, "CPU temp", "cpu_temp")
        self._metric_row(box, "Package temp", "pkg_temp")
        self._metric_row(box, "dGPU temp", "dgpu_temp")
        self._metric_row(box, "iGPU freq", "igpu_freq")

    def _build_audio_section(self, box):
        self._section_title(box, "Audio Xruns (last 1h)")
        self._widgets["xrun_box"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        box.append(self._widgets["xrun_box"])

    def _build_oom_section(self, box):
        self._section_title(box, "OOM Kills (last 1h)")
        self._widgets["oom_box"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        box.append(self._widgets["oom_box"])

    def _build_procs_section(self, box):
        self._section_title(box, "Top Processes")
        self._widgets["proc_box"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        box.append(self._widgets["proc_box"])

    def _set_val(self, key, text, css_class=None):
        w = self._widgets.get(key)
        if w and isinstance(w, Gtk.Label):
            w.set_text(text)
            if css_class:
                for c in ("metric-ok", "metric-warn", "metric-crit"):
                    w.remove_css_class(c)
                w.add_css_class(css_class)

    def _update_log_box(self, box, lines, empty_msg):
        while box.get_first_child() is not None:
            box.remove(box.get_first_child())
        if not lines:
            lbl = Gtk.Label(label=empty_msg, xalign=0)
            lbl.set_css_classes(["log-empty"])
            box.append(lbl)
        else:
            for line in lines[-8:]:
                lbl = Gtk.Label(label=line, xalign=0, wrap=True)
                lbl.set_css_classes(["log-line"])
                box.append(lbl)

    def _refresh(self):
        if self._win is None or not self._widgets:
            return True
        s = take_sample()
        self.history.append(s)
        if self.debug:
            print(f"[{s.ts:.0f}] RAM {s.mem_avail*100//max(s.mem_total,1)}% "
                  f"swap {s.swap_free*100//max(s.swap_total,1)}% "
                  f"PSI {s.psi_some_avg10:.1f}/{s.psi_full_avg10:.1f} "
                  f"CPU {s.cpu_freq_mhz}MHz {s.cpu_temp}C", file=sys.stderr)

        mem_pct = s.mem_avail * 100 / max(s.mem_total, 1)
        swap_pct = s.swap_free * 100 / max(s.swap_total, 1) if s.swap_total > 0 else 100.0
        self._set_val("mem_pct", *pct_label(mem_pct))
        self._widgets["mem_bar"].set_pct(100 - mem_pct)
        self._set_val("swap_pct", *pct_label(swap_pct))
        self._widgets["swap_bar"].set_pct(100 - swap_pct)

        self._set_val("psi_some", *psi_label(s.psi_some_avg10))
        self._set_val("psi_full", *psi_label(s.psi_full_avg10, warn=2.0, crit=5.0))

        self._set_val("load", f"{s.load1:.2f} / {s.load5:.2f}")
        self._set_val("cpu_freq", f"{s.cpu_freq_mhz} / {s.cpu_max_freq_mhz} MHz")
        self._set_val("cpu_temp", *temp_label(s.cpu_temp))
        self._set_val("pkg_temp", *temp_label(s.pkg_temp))
        self._set_val("dgpu_temp", *temp_label(s.dgpu_temp, warn=60, crit=75))
        self._set_val("igpu_freq", f"{s.igpu_freq_mhz} MHz")

        self._update_log_box(self._widgets["xrun_box"], s.xrun_events, "No xrun events")
        self._update_log_box(self._widgets["oom_box"], s.oom_kills, "No OOM kills")

        pbox = self._widgets["proc_box"]
        while pbox.get_first_child() is not None:
            pbox.remove(pbox.get_first_child())
        for pid, name, mem, cpu in s.top_procs:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_css_classes(["proc-row"])

            n = Gtk.Label(label=f"{name}", xalign=0)
            n.set_css_classes(["proc-name"])
            n.set_hexpand(True)
            m = Gtk.Label(label=f"mem {mem:.1f}%  cpu {cpu:.1f}%", xalign=1)
            m.set_css_classes(["proc-num"])

            kill_btn = Gtk.Button()
            kill_btn.set_icon_name("user-trash-symbolic")
            kill_btn.set_tooltip_text(f"Kill {name} (PID {pid})")
            kill_btn.set_css_classes(["proc-kill-btn"])
            kill_btn.connect("clicked", self._kill_proc, pid, name)

            row.append(n)
            row.append(m)
            row.append(kill_btn)
            pbox.append(row)

        # Return True so timeout_add_seconds keeps firing every interval
        return True


def main():
    parser = argparse.ArgumentParser(description="perfwatch -- light performance dashboard")
    parser.add_argument("--interval", type=int, default=2, help="refresh interval in seconds")
    parser.add_argument("--debug", action="store_true", help="print samples to stderr")
    args = parser.parse_args()

    app = Dashboard(interval=args.interval, debug=args.debug)
    # Strip our flags so Gtk doesn't choke on them
    clean_argv = [sys.argv[0]]
    app.run(clean_argv)


if __name__ == "__main__":
    main()
