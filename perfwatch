#!/usr/bin/env python3
"""perfwatch — extremely light GTK4 performance dashboard.

Aggregates the things that kill performance on this machine into one window:
  - Memory / swap / PSI pressure
  - OOM kill log (earlyoom + systemd-oomd)
  - Audio xruns (from audiowatch journal)
  - CPU load / frequency / thermal / throttle
  - iGPU frequency / temperature

Data sources: /proc, /sys, journalctl. No daemon, no dependencies beyond
python-gobject + gtk4 (already installed). ~15MB resident.

Usage:
  perfwatch                 # default 2s refresh
  perfwatch --interval 5    # 5s refresh
  perfwatch --debug          # also print samples to stdout
"""

import argparse
import subprocess
import os
import sys
import time
from dataclasses import dataclass, field
from collections import deque

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib, Gio, Gdk

# GNOME/Mutter doesn't support wlr-layer-shell, so always-on-top is done
# via GNOME Shell's DBus Eval interface (no synthetic keypresses, no
# ydotool, no stuck modifiers).
# The JS snippet calls _toggleAbove on the focused window's Meta.Window.


# --- data sampling ----------------------------------------------------------

@dataclass
class Sample:
    ts: float = 0.0
    mem_total: int = 0
    mem_avail: int = 0
    swap_total: int = 0
    swap_free: int = 0
    psi_some_avg10: float = 0.0
    psi_full_avg10: float = 0.0
    load1: float = 0.0
    load5: float = 0.0
    cpu_freq_mhz: int = 0
    cpu_max_freq_mhz: int = 0
    cpu_temp: int = 0
    pkg_temp: int = 0
    dgpu_temp: int = 0
    igpu_freq_mhz: int = 0
    top_procs: list = field(default_factory=list)
    oom_kills: list = field(default_factory=list)
    xrun_events: list = field(default_factory=list)


def _read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


def sample_mem():
    vals = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) >= 2:
                    vals[parts[0].strip()] = int(parts[1].split()[0])
    except (OSError, ValueError):
        pass
    return vals


def sample_psi():
    some, full = 0.0, 0.0
    try:
        with open("/proc/pressure/memory") as f:
            for line in f:
                if line.startswith("some"):
                    some = float(line.split("avg10=")[1].split()[0])
                elif line.startswith("full"):
                    full = float(line.split("avg10=")[1].split()[0])
    except (OSError, ValueError, IndexError):
        pass
    return some, full


def sample_loadavg():
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
            return float(parts[0]), float(parts[1])
    except (OSError, ValueError):
        return 0.0, 0.0


def sample_cpu_freq():
    cur = _read_int("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq")
    mx = _read_int("/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq")
    return cur // 1000, mx // 1000


def sample_thermal():
    cpu = _read_int("/sys/class/thermal/thermal_zone3/temp") // 1000
    pkg = _read_int("/sys/class/thermal/thermal_zone4/temp") // 1000
    dgpu = _read_int("/sys/class/thermal/thermal_zone1/temp") // 1000
    return cpu, pkg, dgpu


def sample_igpu_freq():
    return _read_int("/sys/class/drm/card1-eDP-1/device/gt_act_freq_mhz")


def sample_top_procs():
    try:
        out = subprocess.run(
            ["ps", "-eo", "pid,%mem,%cpu,comm", "--sort=-%mem", "--no-headers"],
            capture_output=True, text=True, timeout=3
        )
        procs = []
        for line in out.stdout.strip().split("\n")[:6]:
            parts = line.strip().split(None, 3)
            if len(parts) == 4:
                pid, mem, cpu, name = parts
                procs.append((int(pid), name, float(mem), float(cpu)))
        return procs
    except Exception:
        return []


def sample_oom_kills():
    kills = []
    try:
        out = subprocess.run(
            ["journalctl", "-u", "earlyoom", "--since", "1 hour ago",
             "--no-pager", "-g", "Killing|sending SIG|Low memory|oom-kill"],
            capture_output=True, text=True, timeout=4
        )
        for line in out.stdout.strip().split("\n"):
            if line.strip():
                kills.append(line.strip())
    except Exception:
        pass
    try:
        out = subprocess.run(
            ["journalctl", "--user", "-u", "systemd-oomd", "--since", "1 day ago",
             "--no-pager"],
            capture_output=True, text=True, timeout=4
        )
        for line in out.stdout.strip().split("\n"):
            if "killed" in line.lower() or "chose" in line.lower():
                kills.append(line.strip())
    except Exception:
        pass
    return kills[-10:]


def sample_xrun_events():
    events = []
    try:
        out = subprocess.run(
            ["journalctl", "--user", "-t", "audiowatch", "--since", "1 hour ago",
             "--no-pager"],
            capture_output=True, text=True, timeout=4
        )
        for line in out.stdout.strip().split("\n"):
            if line.strip():
                events.append(line.strip())
    except Exception:
        pass
    return events[-10:]


def take_sample():
    s = Sample(ts=time.time())
    mem = sample_mem()
    s.mem_total = mem.get("MemTotal", 1)
    s.mem_avail = mem.get("MemAvailable", 0)
    s.swap_total = mem.get("SwapTotal", 0)
    s.swap_free = mem.get("SwapFree", 0)
    s.psi_some_avg10, s.psi_full_avg10 = sample_psi()
    s.load1, s.load5 = sample_loadavg()
    s.cpu_freq_mhz, s.cpu_max_freq_mhz = sample_cpu_freq()
    s.cpu_temp, s.pkg_temp, s.dgpu_temp = sample_thermal()
    s.igpu_freq_mhz = sample_igpu_freq()
    s.top_procs = sample_top_procs()
    s.oom_kills = sample_oom_kills()
    s.xrun_events = sample_xrun_events()
    return s


